---
import BaseLayout from '../layouts/BaseLayout.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';

const waUrl = 'https://wa.me/256753803582?text=' + encodeURIComponent('Hi! I need a free moving quote. Can you help?');
---
<BaseLayout
  title="Get a Free Moving Quote | Office Movers Kampala"
  description="Request your free, no-obligation moving quote in Kampala. WhatsApp us directly and we'll respond within one hour."
>
  <section class="redirect-section w">
    <span class="eyebrow">Free quote</span>
    <h1 class="redirect__h1">Get a free moving quote<span style="color:#FF7A1A">.</span></h1>
    <p class="redirect__sub">The fastest way to get a quote is straight on WhatsApp. Send us a message and we'll respond within one hour.</p>
    <a href={waUrl} class="btn btn--wa btn--lg redirect__btn" target="_blank" rel="noopener noreferrer">
      <svg width="20" height="20" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true"><path d="M16 0C7.163 0 0 7.163 0 16c0 2.822.737 5.469 2.028 7.769L0 32l8.469-2.007A15.93 15.93 0 0016 32c8.837 0 16-7.163 16-16S24.837 0 16 0zm8.07 22.188c-.337.947-1.97 1.811-2.7 1.868-.73.057-1.424.349-4.8-1.001-4.058-1.629-6.662-5.806-6.862-6.073-.2-.267-1.629-2.163-1.629-4.125 0-1.962 1.029-2.928 1.394-3.328.365-.4.796-.5 1.061-.5h.763c.245.012.573-.093.898.685.337.8 1.144 2.762 1.244 2.962.1.2.167.434.033.7-.133.267-.2.433-.4.666-.2.234-.42.523-.6.702-.2.2-.408.416-.175.816.233.4 1.036 1.707 2.223 2.764 1.527 1.362 2.814 1.784 3.214 1.984.4.2.633.167.866-.1.233-.267 1-1.167 1.267-1.567.267-.4.533-.333.9-.2.367.133 2.329 1.1 2.729 1.3.4.2.667.3.767.467.1.167.1.967-.237 1.914z"/></svg>
      WhatsApp us for a quote
    </a>
    <p class="redirect__or">Or call us directly:</p>
    <div class="redirect__phones">
      <a href="tel:+256782792648" class="btn btn--outline">+256 782 792 648</a>
      <a href="tel:+256753803582" class="btn btn--outline">+256 753 803 582</a>
    </div>
  </section>
  <WhatsAppButton />
</BaseLayout>

<style>
  .redirect-section {
    padding: clamp(64px, 10vw, 120px) 0;
    max-width: 640px;
    text-align: center;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .redirect__h1 {
    font-size: clamp(32px, 5vw, 52px);
    line-height: 1.06;
    margin: 8px 0 20px;
    color: #fff;
  }
  .redirect__sub {
    font-size: 18px;
    color: #9fb0c8;
    line-height: 1.65;
    margin-bottom: 36px;
    max-width: 480px;
  }
  .redirect__btn {
    font-size: 18px;
    padding: 18px 36px;
    border-radius: 12px;
    gap: 10px;
    margin-bottom: 28px;
  }
  .redirect__or {
    font-size: 13px;
    color: #9fb0c8;
    margin-bottom: 14px;
  }
  .redirect__phones {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
  }
  @media (max-width: 480px) {
    .redirect__btn { width: 100%; justify-content: center; }
    .redirect__phones .btn { width: 100%; }
  }
</style>
