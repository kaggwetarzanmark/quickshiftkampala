---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import CTABanner from '../../../components/CTABanner.astro';
import WhatsAppButton from '../../../components/WhatsAppButton.astro';
---
<BaseLayout
  title="Movers in Industrial Area Kampala | Office & Commercial Movers"
  description="Professional movers in Kampala's Industrial Area. Office relocation, warehouse moves and commercial removals. Fixed-price quotes, fully insured. Free on-site survey."
>
  <PageHero
    eyebrow="Industrial Area, Kampala"
    title="Movers in Kampala Industrial Area"
    subtitle="Specialist office and commercial movers in Kampala's Industrial Area. Warehouse relocation, factory moves and business premises clearance. Fixed price, overnight available."
    image="/images/team  back  photo.jpg"
    imageAlt="Quick Shift Kampala crew handling a commercial move in Kampala Industrial Area"
    crumbs={[{label:'Home',href:'/'},{label:'Areas',href:'/service-areas/kampala'},{label:'Industrial Area'}]}
    cta={{label:'Get an Industrial Area quote', href:'https://wa.me/256753803582?text=Hi!%20I%20need%20a%20moving%20quote%20in%20Kampala%20Industrial%20Area.%20Can%20you%20help%3F'}}
  />
  <div class="w page-body">
    <div class="two-col">
      <div>
        <span class="eyebrow">Industrial Area specialists</span>
        <h2 class="h2">Commercial and office moves in Kampala's Industrial Area.</h2>
        <div class="prose">
          <p>Kampala's Industrial Area is the city's manufacturing and logistics hub - home to factories, warehouses, distribution centres, printing firms and light industrial businesses. Moves here involve large volumes, heavy equipment and strict access coordination.</p>
          <p>Quick Shift handles <strong>office movers in Kampala Industrial Area</strong> for businesses relocating their administration offices, as well as partial warehouse moves and commercial premises clearances. We understand the access constraints, security requirements and loading bay logistics common to the area.</p>
          <p>We also serve businesses moving into or out of the Industrial Area to Nakasero, Ntinda, Bugolobi and other Kampala districts.</p>
        </div>
        <a href="https://wa.me/256753803582?text=Hi!%20I%20need%20a%20moving%20quote%20in%20Kampala%20Industrial%20Area.%20Can%20you%20help%3F" target="_blank" rel="noopener noreferrer" class="btn btn--primary btn--lg" style="margin-top:28px">Get an Industrial Area quote</a>
      </div>
      <div class="side-photo">
        <img src="/images/CEO.jpg" alt="Quick Shift Kampala crew member ready for an Industrial Area move" class="img-cover" loading="lazy" width="800" height="600" />
      </div>
    </div>

    <section style="margin-top:72px">
      <span class="eyebrow">What we handle</span>
      <h2 class="h2">Commercial moving services in the Industrial Area.</h2>
      <div class="inc-grid">
        {[
          'Office relocation within Industrial Area',
          'Business premises clearance',
          'Warehouse partial moves',
          'Factory office furniture moving',
          'IT equipment & server relocation',
          'After-hours & weekend moves',
          'Goods-in-transit insurance',
          'Free on-site survey & fixed quote',
        ].map(i => (
          <div class="inc-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#FF7A1A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
            <span>{i}</span>
          </div>
        ))}
      </div>
    </section>

    <section style="margin-top:72px;max-width:760px">
      <span class="eyebrow">FAQs</span>
      <h2 class="h2">Industrial Area moving questions</h2>
      {[
        {q:'Do you move warehouses and factories?', a:'We specialise in office and commercial moves rather than full industrial plant relocation. We handle office furniture, IT equipment, admin areas and business premises clearances within and from the Industrial Area.'},
        {q:'Can you work around production schedules?', a:'Yes. We offer after-hours and weekend moves at no extra charge, so your move can happen without disrupting operations.'},
        {q:'Do you handle heavy office furniture and equipment?', a:'Yes. We have the equipment and trained crew for heavy office furniture, safes, server racks and specialist equipment. All covered by goods-in-transit insurance.'},
      ].map(f => (<details class="faq-item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </section>

    <section style="margin-top:48px">
      <span class="eyebrow">Nearby districts</span>
      <h2 class="h2">We also serve</h2>
      <div style="display:flex;flex-wrap:wrap;gap:12px;margin-top:16px">
        {[
          {l:'Nakasero',  h:'/service-areas/kampala/nakasero'},
          {l:'Bugolobi',  h:'/service-areas/kampala/bugolobi'},
          {l:'Ntinda',    h:'/service-areas/kampala/ntinda'},
          {l:'All districts', h:'/service-areas/kampala'},
        ].map(d => <a href={d.h} class="pill">{d.l}</a>)}
      </div>
    </section>
  </div>
  <CTABanner title="Moving your Industrial Area business?" subtitle="Get a fixed price within 24 hours. We handle office and commercial moves across Kampala's Industrial Area - overnight, weekends, no downtime." primaryLabel="Get a free survey" />
  <WhatsAppButton />
</BaseLayout>
<style>
  .page-body { padding-top: 64px; padding-bottom: 72px; }
  .two-col { display: grid; grid-template-columns: 1fr; gap: 48px; align-items: center; }
  @media (min-width: 900px) { .two-col { grid-template-columns: 1fr 420px; } }
  .side-photo { border-radius: 16px; overflow: hidden; height: 460px; border: 1px solid #2c4263; }
  .inc-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; margin-top: 24px; }
  .inc-item { display: flex; align-items: flex-start; gap: 10px; background: #111f35; border: 1px solid #2c4263; border-radius: 10px; padding: 12px 14px; font-size: 14px; font-weight: 500; color: #cdd8e8; line-height: 1.4; }
  @media (max-width: 640px) {
    .page-body { padding-top: 40px; padding-bottom: 48px; }
    .two-col { gap: 32px; }
    .side-photo { height: 280px; }
  }
</style>
