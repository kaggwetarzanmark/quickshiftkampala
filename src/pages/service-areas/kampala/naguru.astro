---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import CTABanner from '../../../components/CTABanner.astro';
import WhatsAppButton from '../../../components/WhatsAppButton.astro';
---
<!-- KW research: Primary = movers in naguru | Title: Movers in Naguru | Office & Residential Moving -->
<BaseLayout
  title="Movers in Naguru | Office & Residential Moving Services"
  description="Professional office and home movers in Naguru, Kampala. Trusted by businesses and households across the district. Fixed-price quotes. Free on-site survey."
>
  <PageHero
    eyebrow="Naguru, Kampala"
    title="Movers in Naguru"
    subtitle="Office and residential movers in Naguru - professional, insured and fixed-price. Serving the district's growing corporate and residential community."
    image="/images/nagulu.jpeg"
    imageAlt="Naguru Kampala office and residential neighbourhood"
    crumbs={[{label:'Home',href:'/'},{label:'Areas',href:'/service-areas/kampala'},{label:'Naguru'}]}
    cta={{label:'Get a Naguru quote',href:'/get-a-quote'}}
  />
  <div class="w page-body">
    <div class="two-col">
      <div>
        <span class="eyebrow">Naguru specialists</span>
        <h2 class="h2">Corporate and residential moves in Naguru.</h2>
        <div class="prose">
          <p>Naguru is one of Kampala's most sought-after areas - a mix of corporate offices, NGO regional headquarters, media companies and premium residential properties. Quick Shift provides both <strong>office movers in Naguru</strong> and home moving services across the district.</p>
          <p>With good road access off Jinja Road and the Northern Bypass, Naguru moves are typically efficient overnight operations. Same fixed-price model, same professional crew as every other district we serve.</p>
        </div>
        <a href="/get-a-quote" class="btn btn--primary btn--lg" style="margin-top:28px">Get a Naguru quote</a>
      </div>
      <div class="side-photo">
        <img src="/images/nagulu.jpeg" alt="Naguru Kampala neighbourhood office and residential area" class="img-cover" loading="lazy" width="800" height="600" />
      </div>
    </div>
    <section style="margin-top:72px;max-width:760px">
      <span class="eyebrow">FAQs</span>
      <h2 class="h2">Naguru questions</h2>
      {[
        {q:'How much does a move in Naguru cost?',a:'Small offices (1–10 staff) start from UGX 1,500,000. Home moves start from UGX 600,000 for a small apartment. All prices fixed after free on-site survey.'},
        {q:'Do you cover residential areas in Naguru?',a:'Yes. We move households and offices throughout Naguru and into surrounding areas - Ntinda, Bugolobi, Kololo. Same professional crew, same fixed price.'},
      ].map(f => (<details class="faq-item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </section>
    <section style="margin-top:48px">
      <span class="eyebrow">Nearby districts</span>
      <h2 class="h2">We also serve</h2>
      <div style="display:flex;flex-wrap:wrap;gap:12px;margin-top:16px">
        {[{l:'Ntinda',h:'/service-areas/kampala/ntinda'},{l:'Kololo',h:'/service-areas/kampala/kololo'},{l:'Bugolobi',h:'/service-areas/kampala/bugolobi'},{l:'All districts',h:'/service-areas/kampala'}].map(d=><a href={d.h} class="pill">{d.l}</a>)}
      </div>
    </section>
  </div>
  <CTABanner title="Moving in Naguru?" subtitle="Get a fixed price within 24 hours of your free survey." primaryLabel="Get a free survey" />
  <WhatsAppButton />
</BaseLayout>
<style>
  .page-body { padding-top: 64px; padding-bottom: 72px; }
  .two-col { display: grid; grid-template-columns: 1fr; gap: 48px; align-items: center; }
  @media (min-width: 900px) { .two-col { grid-template-columns: 1fr 420px; } }
  .side-photo { border-radius: 16px; overflow: hidden; height: 460px; border: 1px solid #2c4263; }

  /* ── Responsive ── */
  @media (max-width: 640px) {
    .page-body { padding-top: 40px; padding-bottom: 48px; }
    .two-col { gap: 32px; }
    .side-photo { height: 280px; }
  }
</style>
