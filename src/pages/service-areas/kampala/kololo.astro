---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import CTABanner from '../../../components/CTABanner.astro';
import WhatsAppButton from '../../../components/WhatsAppButton.astro';
---
<!-- KW research: Primary = office movers kololo
     Secondary: embassy movers kololo, NGO movers kololo, kololo relocation, embassy movers kampala, NGO relocation kololo
     Title (exact): Office Movers in Kololo | Embassy & NGO Specialists
     Meta (exact, 155 chars): Trusted office movers in Kololo, Kampala. Specialists in embassy, diplomatic mission and NGO relocations. Security-vetted crews. Free on-site survey. Licensed & insured.
     H1: Office Movers in Kololo -->
<BaseLayout
  title="Office Movers in Kololo | Embassy & NGO Specialists"
  description="Trusted office movers in Kololo, Kampala. Specialists in embassy, diplomatic mission and NGO relocations. Security-vetted crews. Free on-site survey. Licensed & insured."
>
  <PageHero eyebrow="Kololo, Kampala" title="Office Movers in Kololo" subtitle="Kololo is Kampala's diplomatic hub - home to embassies, high commissions, UN agencies and international NGOs. We are the specialist office movers trusted by the diplomatic community." image="/images/kololo.jpeg" imageAlt="Kololo diplomatic district Kampala tree-lined streets and embassies" crumbs={[{label:'Home',href:'/'},{label:'Areas',href:'/service-areas/kampala'},{label:'Kololo'}]} cta={{label:'Get a Kololo quote',href:'https://wa.me/256753803582?text=Hi!%20I%20need%20a%20free%20moving%20quote.%20Can%20you%20help%3F'}} />
  <div class="w page-body">
    <div class="two-col">
      <div>
        <span class="eyebrow">Diplomatic district specialists</span>
        <h2 class="h2">Security-aware. Discreet. Professional.</h2>
        <div class="prose">
          <p>A move in Kololo involves security clearances, confidential document protocols, high-value asset handling and often strict scheduling dictated by your home government or organisation's procurement rules. As <strong>embassy movers in Kampala</strong>, we have specific experience with diplomatic and <strong>NGO relocation in Kololo</strong> and the surrounding diplomatic district.</p>
          <p>Our crews are vetted, professionally trained and understand the security expectations of diplomatic clients. We sign NDAs when required and provide crew lists for security vetting in advance of every move.</p>
        </div>
        <a href="https://wa.me/256753803582?text=Hi!%20I%20need%20a%20free%20moving%20quote.%20Can%20you%20help%3F" target="_blank" rel="noopener noreferrer" class="btn btn--primary btn--lg" style="margin-top:28px">Get a Kololo quote</a>
      </div>
      <div class="side-photo"><img src="/images/kololo.jpeg" alt="Professional movers setting up a diplomatic office in Kololo Kampala" class="img-cover" loading="lazy" width="800" height="600" /></div>
    </div>
    <section style="margin-top:72px">
      <span class="eyebrow">Standard for diplomatic moves</span>
      <h2 class="h2">Security features included as standard.</h2>
      <div class="inc-grid">
        {['Advance crew list for security vetting','NDA signing on request','Confidential document protocol','High-value asset documentation','Dedicated site manager throughout','After-hours moves only (if required)','Compact vehicle options for residential streets','Full goods-in-transit insurance'].map(f => (
          <div class="inc-item">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#FF7A1A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
            <span>{f}</span>
          </div>
        ))}
      </div>
    </section>
    <section style="margin-top:72px;max-width:760px">
      <span class="eyebrow">FAQs</span>
      <h2 class="h2">Kololo questions</h2>
      {[
        {q:'Do you provide crew lists for embassy security vetting?',a:'Yes. We provide a full crew list with names and ID numbers at least 48 hours before the move, or earlier if your security team requires it.'},
        {q:'Can you sign an NDA?',a:'Yes. We routinely sign NDAs for diplomatic and corporate clients. Send us your standard NDA and we will review and sign before the survey.'},
        {q:'How do you handle access on Kololo\'s residential streets?',a:'We use appropriately sized vehicles for compound access. For tight access points we use smaller trucks - all within the fixed price.'},
      ].map(f => (<details class="faq-item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </section>
    <section style="margin-top:48px">
      <span class="eyebrow">Nearby districts</span>
      <h2 class="h2">We also serve</h2>
      <div style="display:flex;flex-wrap:wrap;gap:12px;margin-top:16px">
        {[{l:'Nakasero',h:'/service-areas/kampala/nakasero'},{l:'Ntinda',h:'/service-areas/kampala/ntinda'},{l:'Naguru',h:'/service-areas/kampala/naguru'},{l:'All districts',h:'/service-areas/kampala'}].map(d=><a href={d.h} class="pill">{d.l}</a>)}
      </div>
    </section>
  </div>
  <CTABanner title="Moving a diplomatic office in Kololo?" subtitle="We understand the security requirements and access challenges unique to Kololo's diplomatic district." primaryLabel="Get a free survey" />
  <WhatsAppButton />
</BaseLayout>
<style>
  .page-body { padding-top: 64px; padding-bottom: 72px; }
  .two-col { display: grid; grid-template-columns: 1fr; gap: 48px; align-items: center; }
  @media (min-width: 900px) { .two-col { grid-template-columns: 1fr 420px; } }
  .side-photo { border-radius: 16px; overflow: hidden; height: 460px; border: 1px solid #2c4263; }
  .inc-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 10px; margin-top: 24px; }
  .inc-item { display: flex; align-items: flex-start; gap: 10px; background: #111f35; border: 1px solid #2c4263; border-radius: 10px; padding: 12px 14px; font-size: 14px; font-weight: 500; color: #cdd8e8; line-height: 1.4; }

  /* -- Responsive -- */
  @media (max-width: 640px) {
    .page-body { padding-top: 40px; padding-bottom: 48px; }
    .two-col { gap: 32px; }
    .side-photo { height: 280px; }
  }
</style>
