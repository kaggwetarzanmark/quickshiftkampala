---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import CTABanner from '../../../components/CTABanner.astro';
import WhatsAppButton from '../../../components/WhatsAppButton.astro';
---
<BaseLayout
  title="Movers in Bukoto | Home & Office Moving Services Kampala"
  description="Trusted movers in Bukoto, Kampala. Home shifting, office relocation and commercial moves. Fixed-price quotes, fully insured. Free on-site survey."
>
  <PageHero
    eyebrow="Bukoto, Kampala"
    title="Movers in Bukoto"
    subtitle="Professional home and office movers in Bukoto, Kampala. Fixed price, licensed and insured. Serving families, businesses and NGOs across the district."
    image="/images/team.jpg"
    imageAlt="Quick Shift Kampala movers serving Bukoto district"
    crumbs={[{label:'Home',href:'/'},{label:'Areas',href:'/service-areas/kampala'},{label:'Bukoto'}]}
    cta={{label:'Get a Bukoto quote', href:'https://wa.me/256753803582?text=Hi!%20I%20need%20a%20free%20moving%20quote%20in%20Bukoto.%20Can%20you%20help%3F'}}
  />
  <div class="w page-body">
    <div class="two-col">
      <div>
        <span class="eyebrow">Bukoto specialists</span>
        <h2 class="h2">Bukoto home and office moves, done right.</h2>
        <div class="prose">
          <p>Bukoto is one of Kampala's most sought-after residential and commercial areas - a mix of family homes, apartments, embassies and small office blocks. It sits between Kololo and Ntinda, making it a common origin or destination for moves across the city's northern suburbs.</p>
          <p>We handle <strong>home movers in Bukoto</strong> for apartments and family houses, as well as office relocations for small businesses and professional firms. Good road access and proximity to Kololo and Ntinda means most Bukoto moves are efficient and complete within a single session.</p>
          <p>We serve all of Bukoto and surrounding areas including Kisaasi, Kyanja and the upper Bukoto estates.</p>
        </div>
        <a href="https://wa.me/256753803582?text=Hi!%20I%20need%20a%20free%20moving%20quote%20in%20Bukoto.%20Can%20you%20help%3F" target="_blank" rel="noopener noreferrer" class="btn btn--primary btn--lg" style="margin-top:28px">Get a Bukoto quote</a>
      </div>
      <div class="side-photo">
        <img src="/images/team  back  photo.jpg" alt="Quick Shift Kampala crew serving Bukoto district" class="img-cover" loading="lazy" width="800" height="600" />
      </div>
    </div>

    <section style="margin-top:72px">
      <span class="eyebrow">What's included</span>
      <h2 class="h2">Everything in one price.</h2>
      <div class="inc-grid">
        {['Free on-site survey','Professional packing & all materials','Furniture disassembly & reassembly','Fragile item handling','Covered transport','Setup at new address','Goods-in-transit insurance','Weekend moves - no extra charge'].map(i => (
          <div class="inc-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#FF7A1A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
            <span>{i}</span>
          </div>
        ))}
      </div>
    </section>

    <section style="margin-top:72px;max-width:760px">
      <span class="eyebrow">FAQs</span>
      <h2 class="h2">Bukoto moving questions</h2>
      {[
        {q:'How much does it cost to move a house in Bukoto?', a:'Our Silver package starts from UGX 435,500 for a studio room. A 3-bedroom home starts from UGX 780,000. Exact price confirmed after a free on-site survey.'},
        {q:'Do you do home moves in Bukoto?', a:'Yes. We move apartments, family homes and single rooms across Bukoto. Same fixed-price model as all our moves - no hourly rates.'},
        {q:'How long does a Bukoto move take?', a:'A 1-2 bedroom apartment typically completes in 4-6 hours. A 3-4 bedroom home takes 6-10 hours. We confirm the exact duration after the free survey.'},
      ].map(f => (<details class="faq-item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </section>

    <section style="margin-top:48px">
      <span class="eyebrow">Nearby districts</span>
      <h2 class="h2">We also serve</h2>
      <div style="display:flex;flex-wrap:wrap;gap:12px;margin-top:16px">
        {[
          {l:'Kololo',  h:'/service-areas/kampala/kololo'},
          {l:'Ntinda',  h:'/service-areas/kampala/ntinda'},
          {l:'Naguru',  h:'/service-areas/kampala/naguru'},
          {l:'All districts', h:'/service-areas/kampala'},
        ].map(d => <a href={d.h} class="pill">{d.l}</a>)}
      </div>
    </section>
  </div>
  <CTABanner title="Moving in Bukoto?" subtitle="Get a fixed price within 24 hours of your free survey. Home shifts and office moves across Bukoto, same day response." primaryLabel="Get a Bukoto quote" />
  <WhatsAppButton />
</BaseLayout>
<style>
  .page-body { padding-top: 64px; padding-bottom: 72px; }
  .two-col { display: grid; grid-template-columns: 1fr; gap: 48px; align-items: center; }
  @media (min-width: 900px) { .two-col { grid-template-columns: 1fr 420px; } }
  .side-photo { border-radius: 16px; overflow: hidden; height: 460px; border: 1px solid #2c4263; }
  .inc-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; margin-top: 24px; }
  .inc-item { display: flex; align-items: flex-start; gap: 10px; background: #111f35; border: 1px solid #2c4263; border-radius: 10px; padding: 12px 14px; font-size: 14px; font-weight: 500; color: #cdd8e8; line-height: 1.4; }
  @media (max-width: 640px) {
    .page-body { padding-top: 40px; padding-bottom: 48px; }
    .two-col { gap: 32px; }
    .side-photo { height: 280px; }
  }
</style>
