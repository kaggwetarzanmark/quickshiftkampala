---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CTABanner from '../components/CTABanner.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
---
<!-- KW research: Primary = office moving cost kampala
     Secondary: movers prices uganda, how much do movers cost in kampala, moving company rates, office relocation pricing
     Title (exact): Office Moving Prices in Kampala | Transparent Rates
     Meta (exact, 155 chars): Clear, transparent office moving prices in Kampala. No hidden fees. Small, medium & large office rates. Get an instant estimate or book your free on-site survey.
     H1: Clear prices. No surprises. -->
<BaseLayout
  title="Office Moving Prices in Kampala | Transparent Rates"
  description="Clear, transparent office moving prices in Kampala. No hidden fees. Small, medium & large office rates. Get an instant estimate or book your free on-site survey."
>
  <PageHero eyebrow="Pricing" title="Clear prices. No surprises." subtitle="Office moving prices in Kampala - transparent, no hidden fees. Moving company rates for small, medium and large offices. Get an instant estimate or book your free on-site survey." crumbs={[{label:'Home',href:'/'},{label:'Pricing'}]} />
  <div class="w page-body">
    <div class="two-col" style="margin-bottom:72px">
      <div>
        <span class="eyebrow">How it works</span>
        <h2 class="h2">A fixed price, guaranteed.</h2>
        <div class="prose">
          <p>We don't charge by the hour. We visit your office, measure every room, assess access requirements and give you a single fixed price that covers everything from packing to final setup.</p>
          <p>The prices below are starting points. Your actual quote depends on distance, floor level and the services you need. The only way to get your exact number is the free survey.</p>
        </div>
      </div>
      <div class="pricing-steps">
        {[
          {n:'1',t:'Book a free survey',d:'We visit at a time that suits you - no obligation.'},
          {n:'2',t:'Receive your fixed quote',d:'Written quote within 24 hours. Valid for 30 days.'},
          {n:'3',t:'Approve and schedule',d:'Confirm the date and we handle everything else.'},
          {n:'4',t:'Pay on completion',d:'No large upfront deposit required for most moves.'},
        ].map(s => (
          <div class="p-step">
            <span class="p-step__n">{s.n}</span>
            <div><strong class="p-step__t">{s.t}</strong><p class="p-step__d">{s.d}</p></div>
          </div>
        ))}
      </div>
    </div>

    <!-- Tiers -->
    <span class="eyebrow">Pricing tiers</span>
    <h2 class="h2">Choose your office size.</h2>
    <div class="tier-grid">
      {[
        { label:'Small office', size:'1 to 10 staff', price:'From UGX 1,500,000', desc:'Full packing, overnight transport and setup.', features:['Free on-site survey','Professional packing','Overnight transport','Furniture reassembly','Goods-in-transit insurance'], href:'/get-a-quote', featured:false },
        { label:'Medium office', size:'11 to 50 staff', price:'From UGX 4,500,000', desc:'Everything in Small, plus dedicated project manager and IT handling.', features:['Free survey & floor plan','Dedicated project manager','Full packing & labelling','IT equipment handling','Overnight & weekend scheduling','Goods-in-transit insurance'], href:'/get-a-quote', featured:true },
        { label:'Large office', size:'50+ staff', price:'Custom pricing', desc:'Tailored for complex, multi-floor or multi-branch moves.', features:['Free survey & phased plan','Senior project manager','Multi-crew overnight execution','IT infrastructure relocation','Decommissioning & disposal','Post-move support'], href:'/contact', featured:false },
      ].map(t => (
        <div class={`tier-card ${t.featured ? 'tier-card--hi' : ''}`}>
          {t.featured && <div class="tier-badge">Most popular</div>}
          <div class="tier-card__head">
            <strong class="tier-card__name">{t.label}</strong>
            <span class="tier-card__size">{t.size}</span>
          </div>
          <p class="tier-card__desc">{t.desc}</p>
          <div class="tier-card__price">{t.price}</div>
          <ul class="check-list" style="margin-bottom:20px">
            {t.features.map(f => <li>{f}</li>)}
          </ul>
          <a href={t.href} class={`btn ${t.featured ? 'btn--primary' : 'btn--outline'}`} style="width:100%;justify-content:center">
            {t.featured ? 'Get quote' : t.label === 'Large office' ? 'Speak to us' : 'Get quote'}
          </a>
        </div>
      ))}
    </div>

    <!-- Extras -->
    <section style="margin-top:72px">
      <span class="eyebrow">Add-on services</span>
      <h2 class="h2">Other services & what they cost.</h2>
      <div class="extras-table">
        <div class="extras-head"><span>Service</span><span>Starting price</span></div>
        {[
          {s:'Office decommissioning & clearance', p:'From UGX 800,000'},
          {s:'Furniture-only move',                p:'From UGX 600,000'},
          {s:'After-hours premium',                p:'No premium - included'},
          {s:'Weekend move',                       p:'No premium - included'},
          {s:'Building management coordination',   p:'Included in all tiers'},
          {s:'Goods-in-transit insurance',         p:'Included in all tiers'},
        ].map(e => (
          <div class="extras-row">
            <span class="extras-row__s">{e.s}</span>
            <span class="extras-row__p">{e.p}</span>
          </div>
        ))}
      </div>
    </section>
  </div>
  <CTABanner title="Ready for your fixed price?" subtitle="Book your free on-site survey - we visit, measure and send your written quote within 24 hours." primaryLabel="Book a free survey" whatsappLabel="WhatsApp for quick estimate" />
  <WhatsAppButton />
</BaseLayout>
<style>
  .page-body { padding-top: 64px; padding-bottom: 72px; }
  .two-col { display: grid; grid-template-columns: 1fr; gap: 48px; align-items: start; }
  @media (min-width: 900px) { .two-col { grid-template-columns: 1fr 1fr; } }
  .pricing-steps { display: flex; flex-direction: column; gap: 14px; }
  .p-step { display: flex; gap: 16px; align-items: flex-start; background: #111f35; border: 1px solid #2c4263; border-radius: 12px; padding: 16px; }
  .p-step__n { width: 32px; height: 32px; background: #FF7A1A; color: #0B1626; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 14px; flex-shrink: 0; }
  .p-step__t { font-weight: 800; font-size: 15px; color: #fff; display: block; margin-bottom: 2px; }
  .p-step__d { font-size: 13px; color: #9fb0c8; margin: 0; line-height: 1.5; }
  .tier-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-top: 28px; }
  .tier-card { background: #111f35; border: 1px solid #2c4263; border-radius: 20px; padding: 28px; display: flex; flex-direction: column; gap: 14px; position: relative; }
  .tier-card--hi { border-color: #FF7A1A; }
  .tier-badge { position: absolute; top: -13px; left: 50%; transform: translateX(-50%); background: #FF7A1A; color: #0B1626; font-size: 11px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; padding: 4px 14px; border-radius: 99px; white-space: nowrap; }
  .tier-card__head { display: flex; flex-direction: column; gap: 3px; }
  .tier-card__name { font-size: 22px; font-weight: 800; color: #fff; }
  .tier-card__size { font-size: 13px; color: #9fb0c8; }
  .tier-card__desc { font-size: 14px; color: #9fb0c8; line-height: 1.6; }
  .tier-card__price { font-size: 20px; font-weight: 800; color: #FF7A1A; padding: 12px 0; border-top: 1px solid #2c4263; border-bottom: 1px solid #2c4263; }
  .extras-table { border: 1px solid #2c4263; border-radius: 14px; overflow: hidden; margin-top: 24px; }
  .extras-head { display: grid; grid-template-columns: 1fr auto; padding: 12px 20px; background: #0f1d30; font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em; color: #9fb0c8; gap: 16px; }
  .extras-row { display: grid; grid-template-columns: 1fr auto; padding: 14px 20px; border-top: 1px solid #2c4263; gap: 16px; background: #111f35; transition: background 0.15s; }
  .extras-row:hover { background: #132030; }
  .extras-row__s { font-size: 14px; font-weight: 500; color: #cdd8e8; }
  .extras-row__p { font-size: 14px; font-weight: 700; color: #FF7A1A; white-space: nowrap; }
</style>
