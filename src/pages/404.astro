---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page Not Found | Quick Shift Kampala" description="The page you're looking for doesn't exist." noindex={true}>
  <section style="min-height:70vh;display:flex;align-items:center;padding:80px 0">
    <div class="w" style="max-width:580px;margin:auto;text-align:center;display:flex;flex-direction:column;align-items:center;gap:20px">
      <div style="font-size:clamp(6rem,15vw,9rem);font-weight:800;color:rgba(255,122,26,0.15);line-height:1">404</div>
      <h1 style="font-size:clamp(28px,4vw,40px);color:#fff;margin-top:-20px">Page not found.</h1>
      <p style="font-size:17px;color:#9fb0c8;line-height:1.65;max-width:420px">The page you're looking for has moved or doesn't exist. Try one of the links below.</p>
      <div style="display:flex;flex-wrap:wrap;gap:12px;justify-content:center">
        <a href="/" class="btn btn--primary btn--lg">Go home</a>
        <a href="/get-a-quote" class="btn btn--outline btn--lg">Get a quote</a>
        <a href="/contact" class="btn btn--outline btn--lg">Contact us</a>
      </div>
      <div style="margin-top:16px;padding-top:20px;border-top:1px solid #2c4263;width:100%">
        <p style="font-size:12px;color:#9fb0c8;margin-bottom:14px;text-transform:uppercase;letter-spacing:0.08em;font-weight:800">Popular pages</p>
        <div style="display:flex;flex-wrap:wrap;justify-content:center;gap:10px">
          {[{l:'Office Relocation',h:'/services/office-relocation'},{l:'After-Hours Moving',h:'/services/after-hours-moving'},{l:'Pricing',h:'/pricing'},{l:'FAQ',h:'/faq'},{l:'Service Areas',h:'/service-areas/kampala'}].map(p=>(
            <a href={p.h} style="font-size:13px;font-weight:600;color:#9fb0c8;text-decoration:none;padding:7px 14px;border:1px solid #2c4263;border-radius:99px;transition:border-color 0.15s,color 0.15s" class="nf-pill">{p.l}</a>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
<style>
  .nf-pill:hover { border-color: #FF7A1A !important; color: #FF7A1A !important; }
</style>
