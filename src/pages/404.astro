---
import BaseLayout from '../layouts/BaseLayout.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';

const waUrl = 'https://wa.me/256753803582?text=' + encodeURIComponent('Hi! I need a free moving quote. Can you help?');
---
<BaseLayout
  title="Page Not Found | Quick Shift Kampala"
  description="The page you are looking for does not exist. Go back to Quick Shift Kampala - trusted home and office movers in Kampala, Uganda."
  noindex={true}
>
  <section class="notfound">
    <div class="w notfound__inner">

      <!-- Left: copy -->
      <div class="notfound__copy">
        <span class="notfound__code">404</span>
        <h1 class="notfound__h1">Looks like this page moved.</h1>
        <p class="notfound__sub">We move things for a living - but even we lose a page sometimes. The one you are looking for does not exist. Let us point you in the right direction.</p>

        <div class="notfound__links">
          <a href="/" class="btn btn--primary btn--lg">Go to homepage</a>
          <a href={waUrl} class="btn btn--wa btn--lg" target="_blank" rel="noopener noreferrer">
            <svg width="18" height="18" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true"><path d="M16 0C7.163 0 0 7.163 0 16c0 2.822.737 5.469 2.028 7.769L0 32l8.469-2.007A15.93 15.93 0 0016 32c8.837 0 16-7.163 16-16S24.837 0 16 0zm8.07 22.188c-.337.947-1.97 1.811-2.7 1.868-.73.057-1.424.349-4.8-1.001-4.058-1.629-6.662-5.806-6.862-6.073-.2-.267-1.629-2.163-1.629-4.125 0-1.962 1.029-2.928 1.394-3.328.365-.4.796-.5 1.061-.5h.763c.245.012.573-.093.898.685.337.8 1.144 2.762 1.244 2.962.1.2.167.434.033.7-.133.267-.2.433-.4.666-.2.234-.42.523-.6.702-.2.2-.408.416-.175.816.233.4 1.036 1.707 2.223 2.764 1.527 1.362 2.814 1.784 3.214 1.984.4.2.633.167.866-.1.233-.267 1-1.167 1.267-1.567.267-.4.533-.333.9-.2.367.133 2.329 1.1 2.729 1.3.4.2.667.3.767.467.1.167.1.967-.237 1.914z"/></svg>
            WhatsApp us
          </a>
        </div>

        <div class="notfound__pages">
          <p class="notfound__pages-label">Popular pages</p>
          <div class="notfound__pages-grid">
            {[
              { label: 'Home Moving',        href: '/services/home-moving',         desc: 'House shifting from UGX 435,500' },
              { label: 'Office Relocation',  href: '/services/office-relocation',   desc: 'Overnight, zero downtime' },
              { label: 'Pricing',            href: '/pricing',                       desc: 'Silver & Gold packages' },
              { label: 'After-Hours Moving', href: '/services/after-hours-moving',  desc: 'Nights & weekends' },
              { label: 'FAQ',                href: '/faq',                           desc: 'Common questions answered' },
              { label: 'Contact',            href: '/contact',                       desc: 'Call or WhatsApp us' },
            ].map(p => (
              <a href={p.href} class="notfound__page-card">
                <strong class="notfound__page-card__title">{p.label}</strong>
                <span class="notfound__page-card__desc">{p.desc}</span>
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Right: crew photo -->
      <div class="notfound__photo">
        <img
          src="/images/team.jpg"
          alt="Quick Shift Kampala crew ready to help"
          class="img-cover"
          loading="eager"
          width="600"
          height="700"
        />
        <div class="notfound__photo-badge">
          We move you quickly &amp; safely
        </div>
      </div>

    </div>
  </section>
  <WhatsAppButton />
</BaseLayout>

<style>
  .notfound {
    min-height: 80vh;
    display: flex;
    align-items: center;
    padding: clamp(48px, 8vw, 80px) 0;
  }

  .notfound__inner {
    display: grid;
    grid-template-columns: 1fr 400px;
    gap: 64px;
    align-items: center;
  }

  /* Left copy */
  .notfound__code {
    display: block;
    font-size: clamp(80px, 14vw, 140px);
    font-weight: 800;
    line-height: 1;
    color: rgba(255,122,26,0.15);
    letter-spacing: -4px;
    margin-bottom: -16px;
  }

  .notfound__h1 {
    font-size: clamp(28px, 4vw, 44px);
    font-weight: 800;
    color: #fff;
    line-height: 1.1;
    margin-bottom: 16px;
  }

  .notfound__sub {
    font-size: 17px;
    color: #9fb0c8;
    line-height: 1.65;
    max-width: 500px;
    margin-bottom: 32px;
  }

  .notfound__links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 48px;
  }

  /* Popular pages grid */
  .notfound__pages-label {
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255,255,255,0.3);
    margin-bottom: 14px;
  }

  .notfound__pages-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .notfound__page-card {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 14px 16px;
    background: #111f35;
    border: 1px solid #2c4263;
    border-radius: 12px;
    text-decoration: none;
    transition: border-color 0.2s, background 0.2s;
  }
  .notfound__page-card:hover { border-color: #FF7A1A; background: #132030; }
  .notfound__page-card__title { font-size: 14px; font-weight: 800; color: #fff; }
  .notfound__page-card__desc  { font-size: 12px; color: #9fb0c8; }

  /* Right photo */
  .notfound__photo {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    height: 520px;
    border: 1px solid #2c4263;
  }

  .notfound__photo-badge {
    position: absolute;
    bottom: 20px;
    left: 20px;
    right: 20px;
    background: rgba(11,22,38,0.88);
    border: 1px solid #2c4263;
    border-radius: 12px;
    padding: 14px 18px;
    font-size: 14px;
    font-weight: 800;
    color: #fff;
    text-align: center;
    backdrop-filter: blur(4px);
  }

  /* Responsive */
  @media (max-width: 900px) {
    .notfound__inner { grid-template-columns: 1fr; gap: 40px; }
    .notfound__photo { height: 300px; order: -1; }
  }

  @media (max-width: 480px) {
    .notfound__links .btn { width: 100%; justify-content: center; }
    .notfound__pages-grid { grid-template-columns: 1fr; }
    .notfound__photo { height: 240px; }
  }
</style>
