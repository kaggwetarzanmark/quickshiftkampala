---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Thank You | Quick Shift Kampala" description="We've received your request and will be in touch within one hour." noindex={true}>
  <section style="min-height:60vh;display:flex;align-items:center;padding:80px 0">
    <div class="w" style="max-width:560px;margin:auto;text-align:center;display:flex;flex-direction:column;align-items:center;gap:24px">
      <div style="width:80px;height:80px;background:rgba(255,122,26,0.12);border-radius:50%;display:flex;align-items:center;justify-content:center">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#FF7A1A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><path d="M22 4L12 14.01l-3-3"/></svg>
      </div>
      <h1 style="font-size:clamp(28px,4vw,40px);line-height:1.1;color:#fff">We've got your message.</h1>
      <p style="font-size:18px;color:#9fb0c8;line-height:1.65">Our team will be in touch within <strong style="color:#FF7A1A">one hour</strong> during business hours (Mon–Sat, 7am–6pm). For urgent moves, WhatsApp us directly.</p>
      <div style="display:flex;flex-wrap:wrap;gap:12px;justify-content:center">
        <a href="/" class="btn btn--primary btn--lg">Back to home</a>
        <a href="https://wa.me/256753803582" class="btn btn--wa btn--lg" target="_blank" rel="noopener noreferrer">WhatsApp us now</a>
      </div>
    </div>
  </section>
</BaseLayout>
