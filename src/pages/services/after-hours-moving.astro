---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CTABanner from '../../components/CTABanner.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
---
<!-- KW research: Primary = weekend office movers kampala
     Secondary: after hours moving kampala, overnight office move, evening office relocation, weekend commercial movers
     Title (exact): Weekend & After-Hours Office Movers | Kampala, Uganda
     Meta (exact, 154 chars): Need to move your office without disrupting work? Our after-hours and weekend moving services in Kampala keep your business running. Book your off-hours move.
     H1 (exact): After-Hours & Weekend Office Moving in Kampala -->
<BaseLayout
  title="Weekend & After-Hours Office Movers | Kampala, Uganda"
  description="Need to move your office without disrupting work? Our after-hours and weekend moving services in Kampala keep your business running. Book your off-hours move."
>
  <PageHero eyebrow="After-Hours Moving" title="After-Hours &amp; Weekend Office Moving in Kampala" subtitle="Weekend and after-hours office movers in Kampala - we work nights so your business keeps running. No downtime, no overtime premium." image="https://images.unsplash.com/photo-1534438327276-14e5300c3a48?w=1600&q=80&auto=format&fit=crop" imageAlt="Office building at night during an overnight move in Kampala Uganda" crumbs={[{label:'Home',href:'/'},{label:'Services',href:'/services'},{label:'After-Hours Moving'}]} cta={{label:'Book an overnight move',href:'https://wa.me/256753803582?text=Hi!%20I%20need%20a%20free%20moving%20quote.%20Can%20you%20help%3F'}} />
  <div class="w page-body">
    <div class="two-col">
      <div>
        <span class="eyebrow">Your business never stops</span>
        <h2 class="h2">Move overnight. Open Monday.</h2>
        <div class="prose">
          <p>A daytime office move means lost productivity - staff can't work, computers are disconnected and routes are blocked. In a competitive market, a day of downtime costs real money.</p>
          <p>Quick Shift eliminates that cost entirely. Our crew arrives when your last team member leaves. The move is complete before your first staff member arrives the next morning.</p>
          <p>No overtime premium. After-hours work is our standard mode of operation - it's included in your fixed quote.</p>
        </div>
        <a href="https://wa.me/256753803582?text=Hi!%20I%20need%20a%20free%20moving%20quote.%20Can%20you%20help%3F" target="_blank" rel="noopener noreferrer" class="btn btn--primary btn--lg" style="margin-top:28px">Book an overnight move</a>
      </div>
      <div class="side-photo"><img src="https://images.unsplash.com/photo-1521791136064-7986c2920216?w=800&q=80&auto=format&fit=crop" alt="Quick Shift crew setting up office furniture overnight" class="img-cover" loading="lazy" width="800" height="600" /></div>
    </div>
    <section style="margin-top:72px">
      <span class="eyebrow">How the night unfolds</span>
      <h2 class="h2">A typical Friday-to-Monday move.</h2>
      <div class="timeline">
        {[
          {t:'5:00 pm',  e:'Your team leaves the old office as normal on Friday.'},
          {t:'7:00 pm',  e:'Quick Shift crew arrives. Building access confirmed. Packing begins.'},
          {t:'10:00 pm', e:'Loading underway. All furniture wrapped, crates sealed and labelled.'},
          {t:'12:00 am', e:'Transport convoy departs for new address.'},
          {t:'2:00 am',  e:'Unloading begins. Furniture placed per floor plan.'},
          {t:'5:00 am',  e:'Desks assembled, monitors placed, cables routed.'},
          {t:'7:00 am',  e:'Final walkthrough. Old premises broom-clean.'},
          {t:'8:00 am Mon',e:'Your team arrives to a fully set-up office.'},
        ].map(r => (
          <div class="tl-row">
            <span class="tl-time">{r.t}</span>
            <span class="tl-dot" aria-hidden="true"></span>
            <span class="tl-event">{r.e}</span>
          </div>
        ))}
      </div>
    </section>
    <section style="margin-top:72px;max-width:760px">
      <span class="eyebrow">Questions</span>
      <h2 class="h2">After-hours moving FAQs</h2>
      {[
        {q:'Do weekend or after-hours moves cost more?',a:'No. After-hours and weekend moves are priced the same as weekday moves. It\'s our standard mode of operation, not an exception.'},
        {q:'How late can you start a move?',a:'We typically start between 7pm and 9pm, once the working day is over. We coordinate freight lift and loading bay access at both buildings.'},
        {q:'Can you complete an entire office move overnight?',a:'Yes - for small to medium offices (up to ~50 staff). For larger offices we use the full weekend window, starting Friday night and completing by Sunday evening.'},
      ].map(f => (<details class="faq-item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </section>
  </div>
  <CTABanner title="Ready to move without the downtime?" subtitle="Tell us your move date and we'll plan an overnight schedule that keeps your business running." primaryLabel="Book an overnight move" />
  <WhatsAppButton />
</BaseLayout>
<style>
  .page-body { padding-top: 64px; padding-bottom: 72px; }
  .two-col { display: grid; grid-template-columns: 1fr; gap: 48px; align-items: center; }
  @media (min-width: 900px) { .two-col { grid-template-columns: 1fr 420px; } }
  .side-photo { border-radius: 16px; overflow: hidden; height: 460px; border: 1px solid #2c4263; }
  .timeline { display: flex; flex-direction: column; gap: 0; margin-top: 28px; }
  .tl-row { display: grid; grid-template-columns: 100px 20px 1fr; gap: 16px; align-items: flex-start; padding-bottom: 20px; position: relative; }
  .tl-row:not(:last-child)::before { content:''; position:absolute; left:calc(100px + 26px); top:10px; bottom:0; width:2px; background:#2c4263; }
  .tl-time  { font-weight: 800; font-size: 13px; color: #FF7A1A; text-align: right; padding-top: 2px; }
  .tl-dot   { width: 10px; height: 10px; border-radius: 50%; background: #FF7A1A; border: 2px solid #0B1626; box-shadow: 0 0 0 2px #FF7A1A; margin-top: 4px; flex-shrink: 0; position: relative; z-index: 1; }
  .tl-event { font-size: 15px; color: #cdd8e8; line-height: 1.5; }

  /* -- Responsive -- */
  @media (max-width: 640px) {
    .page-body { padding-top: 40px; padding-bottom: 48px; }
    .two-col { gap: 32px; }
    .side-photo { height: 280px; }
  }
  @media (max-width: 480px) {
    .tl-row { grid-template-columns: 72px 20px 1fr; gap: 10px; }
    .tl-time { font-size: 12px; }
    .tl-event { font-size: 14px; }
  }
</style>
