---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CTABanner from '../../components/CTABanner.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
---
<!-- KW research: Primary = corporate relocation services uganda
     Secondary: corporate movers kampala, business relocation uganda, company relocation services
     Title (exact): Corporate Relocation Services Uganda | Business Moving Experts
     Meta (exact, 155 chars): End-to-end corporate relocation services in Uganda. From planning to final setup, we ensure your business moves smoothly. Trusted by top companies. Get a quote.
     H1 (exact): Corporate Relocation Services in Uganda -->
<BaseLayout
  title="Corporate Relocation Services Uganda | Business Moving Experts"
  description="End-to-end corporate relocation services in Uganda. From planning to final setup, we ensure your business moves smoothly. Trusted by top companies. Get a quote."
>
  <PageHero eyebrow="Corporate Relocation" title="Corporate Relocation Services in Uganda" subtitle="End-to-end corporate relocation - from planning to final setup. Multi-branch moves, dedicated project manager, full IT coordination. Trusted by top companies." image="https://images.unsplash.com/photo-1553484771-371a605b060b?w=1600&q=80&auto=format&fit=crop" imageAlt="Corporate relocation project manager overseeing a multi-branch move in Uganda" crumbs={[{label:'Home',href:'/'},{label:'Services',href:'/services'},{label:'Corporate Relocation'}]} cta={{label:'Get a corporate quote',href:'https://wa.me/256753803582?text=Hi!%20I%20need%20a%20free%20moving%20quote.%20Can%20you%20help%3F'}} />
  <div class="w page-body">
    <div class="two-col">
      <div>
        <span class="eyebrow">One manager. Every detail.</span>
        <h2 class="h2">Corporate moves demand a specialist.</h2>
        <div class="prose">
          <p>Corporate relocations involve multiple departments, multiple IT systems, multiple stakeholders - each with their own requirements and deadline. A single missed detail on move night means your business can't open on Monday.</p>
          <p>Quick Shift assigns a dedicated senior project manager to every corporate relocation. They own the plan from the first survey to the final walkthrough. One number, total accountability.</p>
        </div>
        <a href="https://wa.me/256753803582?text=Hi!%20I%20need%20a%20free%20moving%20quote.%20Can%20you%20help%3F" target="_blank" rel="noopener noreferrer" class="btn btn--primary btn--lg" style="margin-top:28px">Get a corporate quote</a>
      </div>
      <div class="side-photo"><img src="https://images.unsplash.com/photo-1521791136064-7986c2920216?w=800&q=80&auto=format&fit=crop" alt="Senior project manager overseeing corporate office relocation" class="img-cover" loading="lazy" width="800" height="600" /></div>
    </div>
    <section style="margin-top:72px">
      <span class="eyebrow">What you get</span>
      <h2 class="h2">Corporate relocation features.</h2>
      <div class="g" style="margin-top:8px">
        {[
          {t:'Dedicated senior PM',d:'Named manager from survey to handover. Available by phone and WhatsApp throughout.'},
          {t:'Phased planning',d:'Department by department, floor by floor. Each phase has its own crew and checklist.'},
          {t:'Multi-branch coordination',d:'Simultaneous moves at multiple locations so all branches open on the same day.'},
          {t:'IT infrastructure',d:'Servers, racks, UPS, CCTV - disconnected, transported and reconnected by trained technicians.'},
          {t:'Stakeholder management',d:'Written status updates. We attend internal briefings and present the plan to your ops team.'},
          {t:'Post-move support',d:'24-hour helpline after move night for any setup issues. We don\'t disappear.'},
        ].map(c => (
          <div class="feat-card">
            <strong class="feat-card__title">{c.t}</strong>
            <p class="feat-card__desc">{c.d}</p>
          </div>
        ))}
      </div>
    </section>
    <section style="margin-top:72px;max-width:760px">
      <span class="eyebrow">FAQs</span>
      <h2 class="h2">Corporate relocation questions</h2>
      {[
        {q:'What\'s the difference between office moving and corporate relocation?',a:'Corporate relocation involves greater complexity - multiple departments, parallel workstreams, IT infrastructure and stakeholder management. We assign a senior PM, produce a written project plan and run structured reviews.'},
        {q:'Do you handle multi-office relocations across Uganda?',a:'Yes. We coordinate simultaneous or phased moves across multiple Kampala locations or between cities. All logistics managed centrally by your project manager.'},
        {q:'Can you accommodate our procurement requirements?',a:'Yes. We issue formal quotes, VAT invoices and can work within procurement frameworks that require multiple quotes or approval stages.'},
      ].map(f => (<details class="faq-item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </section>
  </div>
  <CTABanner title="Planning a corporate relocation?" subtitle="Tell us the scale and timeline - we'll send a structured project plan within 48 hours." primaryLabel="Get a corporate quote" />
  <WhatsAppButton />
</BaseLayout>
<style>
  .page-body { padding-top: 64px; padding-bottom: 72px; }
  .two-col { display: grid; grid-template-columns: 1fr; gap: 48px; align-items: center; }
  @media (min-width: 900px) { .two-col { grid-template-columns: 1fr 420px; } }
  .side-photo { border-radius: 16px; overflow: hidden; height: 460px; border: 1px solid #2c4263; }
  .feat-card { background: #111f35; border: 1px solid #2c4263; border-radius: 14px; padding: 22px; }
  .feat-card__title { font-size: 17px; font-weight: 800; color: #fff; display: block; margin-bottom: 8px; }
  .feat-card__desc  { font-size: 14px; color: #9fb0c8; line-height: 1.6; margin: 0; }

  /* -- Responsive -- */
  @media (max-width: 640px) {
    .page-body { padding-top: 40px; padding-bottom: 48px; }
    .two-col { gap: 32px; }
    .side-photo { height: 280px; }
  }
</style>
