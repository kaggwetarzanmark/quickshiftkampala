---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CTABanner from '../../components/CTABanner.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';

const items = ['Furniture removal & documentation','IT & e-waste responsible disposal','Office partition dismantling','Cabling removal','Minor restoration & patching','Broom-clean handback','Donation of usable furniture to local charities','Disposal documentation for your records'];
---
<!-- KW research: Primary = office decommissioning kampala
     Secondary: office clearance uganda, office disposal services, end of lease office clearance, office space restoration
     Title (exact): Office Decommissioning Services Kampala | Clearance & Disposal
     Meta (exact, 156 chars): Complete office decommissioning in Kampala. Furniture removal, disposal, recycling & space restoration. Meet your lease obligations. Professional & eco-friendly.
     H1 (exact): Office Decommissioning & Clearance Services in Kampala -->
<BaseLayout
  title="Office Decommissioning Services Kampala | Clearance & Disposal"
  description="Complete office decommissioning in Kampala. Furniture removal, disposal, recycling & space restoration. Meet your lease obligations. Professional & eco-friendly."
>
  <PageHero eyebrow="Decommissioning" title="Office Decommissioning &amp; Clearance Services in Kampala" subtitle="Complete office decommissioning in Kampala - furniture removal, disposal, recycling and space restoration. Meet your end-of-lease obligations professionally." image="https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?w=1600&q=80&auto=format&fit=crop" imageAlt="Empty office being professionally cleared and decommissioned in Kampala" crumbs={[{label:'Home',href:'/'},{label:'Services',href:'/services'},{label:'Decommissioning'}]} cta={{label:'Get a clearance quote',href:'/get-a-quote'}} />
  <div class="w page-body">
    <div class="two-col">
      <div>
        <span class="eyebrow">End-of-lease clearance</span>
        <h2 class="h2">Leave nothing behind but a clean space.</h2>
        <div class="prose">
          <p>Kampala's office market is seeing a wave of relocations as companies upgrade to Grade A buildings, downsize for hybrid work or simply find better-located premises. That creates a specific problem: what do you do with the old space?</p>
          <p>We review your lease, plan the clearance, document every item removed and hand back the space in a condition your landlord will accept. You keep your deposit and avoid unexpected restoration charges.</p>
        </div>
        <a href="/get-a-quote" class="btn btn--primary btn--lg" style="margin-top:28px">Get a decommissioning quote</a>
      </div>
      <div class="side-photo"><img src="https://images.unsplash.com/photo-1572025442646-866d16c84a54?w=800&q=80&auto=format&fit=crop" alt="Empty office being professionally cleared" class="img-cover" loading="lazy" width="800" height="600" /></div>
    </div>
    <section style="margin-top:72px">
      <span class="eyebrow">What's covered</span>
      <h2 class="h2">Complete decommissioning, top to bottom.</h2>
      <div class="inc-grid">
        {items.map(item => (
          <div class="inc-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#FF7A1A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
            <span>{item}</span>
          </div>
        ))}
      </div>
    </section>
    <section style="margin-top:72px;max-width:760px">
      <span class="eyebrow">Questions</span>
      <h2 class="h2">Decommissioning FAQs</h2>
      {[
        {q:'What does office decommissioning include?',a:'Furniture removal, IT disposal, partition dismantling, cabling removal, minor restoration and a broom-clean handback. We document everything for your landlord.'},
        {q:'Can you help us meet end-of-lease requirements?',a:'Yes. We review your lease terms before starting so we know exactly what condition the space needs to be returned in. We coordinate the formal handback inspection.'},
        {q:'Do you recycle or donate old office furniture?',a:'Yes. We prioritise donation to Kampala schools and NGOs. Items that can\'t be donated are disposed of through licensed recycling partners. You receive documentation.'},
      ].map(f => (<details class="faq-item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </section>
  </div>
  <CTABanner title="Ready to hand back your old office?" subtitle="Get a fixed clearance quote within 24 hours of your free on-site survey." primaryLabel="Get a decommissioning quote" />
  <WhatsAppButton />
</BaseLayout>
<style>
  .page-body { padding-top: 64px; padding-bottom: 72px; }
  .two-col { display: grid; grid-template-columns: 1fr; gap: 48px; align-items: center; }
  @media (min-width: 900px) { .two-col { grid-template-columns: 1fr 420px; } }
  .side-photo { border-radius: 16px; overflow: hidden; height: 460px; border: 1px solid #2c4263; }
  .inc-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; margin-top: 24px; }
  .inc-item { display: flex; align-items: flex-start; gap: 10px; background: #111f35; border: 1px solid #2c4263; border-radius: 10px; padding: 12px 14px; font-size: 14px; font-weight: 500; color: #cdd8e8; line-height: 1.4; }

  /* ── Responsive ── */
  @media (max-width: 640px) {
    .page-body { padding-top: 40px; padding-bottom: 48px; }
    .two-col { gap: 32px; }
    .side-photo { height: 280px; }
  }
</style>
