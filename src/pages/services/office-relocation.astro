---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CTABanner from '../../components/CTABanner.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';

const faqSchema = {
  "@context":"https://schema.org","@type":"FAQPage",
  "mainEntity":[
    { "@type":"Question","name":"What is included in your office relocation service?","acceptedAnswer":{"@type":"Answer","text":"Free on-site survey, floor plan, labelled packing, furniture disassembly, overnight transport, reassembly and complete setup - so your team walks in ready to work."}},
    { "@type":"Question","name":"How far in advance should I book?","acceptedAnswer":{"@type":"Answer","text":"Small offices: 2 weeks. Medium (10–50 staff): 4 weeks. Large or complex: 6–8 weeks."}},
    { "@type":"Question","name":"How do you minimise disruption?","acceptedAnswer":{"@type":"Answer","text":"We move at night and on weekends, label every item to its exact new position and complete setup before your first staff member arrives."}},
    { "@type":"Question","name":"What happens if something is damaged?","acceptedAnswer":{"@type":"Answer","text":"We carry comprehensive goods-in-transit insurance. Every item is documented before we touch it. If anything is damaged we handle the claim and replace or repair it at no cost to you."}},
  ]
};

const includes = [
  'Free on-site survey & fixed written quote',
  'Detailed floor plan & labelled crates',
  'Professional packing & protective wrapping',
  'Furniture disassembly & full reassembly',
  'Overnight or weekend execution',
  'IT equipment handling & reconnection',
  'Complete setup before staff arrive',
  'Goods-in-transit insurance',
  'Dedicated project manager',
  'Building management coordination',
];
---

<!-- KW research: Primary = office relocation services kampala
     Secondary: office relocation uganda, office moving services, corporate office movers, office shifting kampala
     Title (exact, 57 chars): Office Relocation Services in Kampala | Zero Downtime Moves
     Meta (exact, 154 chars): Expert office relocation services in Kampala. We handle furniture, equipment & setup - so your business keeps running. Licensed & insured. Free on-site survey.
     H1 (exact): Office Relocation Services in Kampala -->
<BaseLayout
  title="Office Relocation Services in Kampala | Zero Downtime Moves"
  description="Expert office relocation services in Kampala. We handle furniture, equipment & setup - so your business keeps running. Licensed & insured. Free on-site survey."
  schema={faqSchema}
>
  <PageHero
    eyebrow="Office Relocation"
    title="Office Relocation Services in Kampala"
    subtitle="We handle furniture, equipment and setup - so your business keeps running. Overnight moves, fixed price, zero downtime."
    image="https://images.unsplash.com/photo-1497366216548-37526070297c?w=1600&q=80&auto=format&fit=crop"
    imageAlt="Modern open-plan office being professionally relocated in Kampala Uganda"
    crumbs={[{label:'Home',href:'/'},{label:'Services',href:'/services'},{label:'Office Relocation'}]}
    cta={{ label:'Get a free quote', href:'/get-a-quote' }}
    ctaSecondary={{ label:'WhatsApp us', href:'https://wa.me/256700000000' }}
  />

  <div class="w page-body">
    <!-- INTRO -->
    <div class="two-col">
      <div>
        <span class="eyebrow">Why Quick Shift</span>
        <h2 class="h2">Kampala's office relocation specialists.</h2>
        <div class="prose">
          <p>Relocating an office in Kampala is complicated. Building management approval, elevator bookings, parking restrictions, IT disconnection - every detail has to be right or your business pays in downtime.</p>
          <p>Quick Shift manages every step. We've moved 100+ offices across Nakasero, Kololo, Ntinda and every other district. We know which buildings have freight lifts, which don't, and exactly how to work around both.</p>
          <p>The result: your team arrives at a fully set-up office on Monday morning. To them, the move was invisible.</p>
        </div>
      </div>
      <div class="side-photo">
        <img src="https://images.unsplash.com/photo-1497366811353-6870744d04b2?w=800&q=80&auto=format&fit=crop" alt="Quick Shift team packing office equipment" class="img-cover" loading="lazy" width="800" height="600" />
      </div>
    </div>

    <!-- INCLUDES -->
    <section aria-labelledby="inc-h2" style="margin-top:72px">
      <span class="eyebrow">What's included</span>
      <h2 class="h2" id="inc-h2">Everything covered, end to end.</h2>
      <div class="inc-grid">
        {includes.map(item => (
          <div class="inc-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#FF7A1A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
            <span>{item}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- PROCESS -->
    <section aria-labelledby="proc-h2" style="margin-top:72px">
      <span class="eyebrow">The process</span>
      <h2 class="h2" id="proc-h2">From survey to first day at work.</h2>
      <div class="g" style="margin-top:8px">
        {[
          { n:'01', t:'Free survey',  d:'We visit both offices, measure and assess access. Fixed quote within 24 hours.' },
          { n:'02', t:'Plan & label', d:'Detailed floor plan. Every crate labelled to its exact new position.' },
          { n:'03', t:'Move night',   d:'Crew arrives after close of business. Everything packed, loaded and transported overnight.' },
          { n:'04', t:'Set up & done',d:'Desks assembled, IT reconnected, filing in place. Walkthrough before we leave.' },
        ].map(s => (
          <div class="step-bar">
            <div class="step-eyebrow">{s.n}</div>
            <b class="step-title">{s.t}</b>
            <p class="step-desc">{s.d}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- FAQ -->
    <section aria-labelledby="faq-h2" style="margin-top:72px;max-width:760px">
      <span class="eyebrow">Questions answered</span>
      <h2 class="h2" id="faq-h2">About office relocation in Kampala</h2>
      {[
        { q:'What is included in your office relocation service?', a:'Free on-site survey, floor plan, labelled packing, furniture disassembly, overnight transport, reassembly and complete setup - so your team walks in ready to work.' },
        { q:'How far in advance should I book?', a:'Small offices: 2 weeks. Medium (10–50 staff): 4 weeks. Large or complex: 6–8 weeks. The earlier, the more date options we can offer.' },
        { q:'How do you minimise disruption to our business?', a:'We move at night and weekends, label every item to its exact new position and complete setup before your first staff member arrives.' },
        { q:'What happens if something is damaged?', a:'We carry comprehensive goods-in-transit insurance. Every item is documented before we touch it. If anything is damaged we handle the claim and replace or repair at no cost to you.' },
      ].map(f => (
        <details class="faq-item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </section>
  </div>

  <CTABanner title="Ready to move your office?" subtitle="Get a fixed price within 24 hours of your free survey." primaryLabel="Get a free quote" />
  <WhatsAppButton />
</BaseLayout>

<style>
  .page-body { padding-top: 64px; padding-bottom: 72px; }
  .two-col { display: grid; grid-template-columns: 1fr; gap: 48px; align-items: center; }
  @media (min-width: 900px) { .two-col { grid-template-columns: 1fr 420px; } }
  .side-photo { border-radius: 16px; overflow: hidden; height: 460px; border: 1px solid #2c4263; }
  .inc-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; margin-top: 24px; }
  .inc-item { display: flex; align-items: flex-start; gap: 10px; background: #111f35; border: 1px solid #2c4263; border-radius: 10px; padding: 12px 14px; font-size: 14px; font-weight: 500; color: #cdd8e8; line-height: 1.4; }
  .step-eyebrow { color: #FF7A1A; font-weight: 800; font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; margin-bottom: 8px; }
  .step-title   { font-size: 20px; font-weight: 800; color: #fff; display: block; margin-bottom: 8px; }
  .step-desc    { color: #9fb0c8; line-height: 1.5; font-size: 15px; margin: 0; }

  /* ── Responsive ── */
  @media (max-width: 640px) {
    .page-body { padding-top: 40px; padding-bottom: 48px; }
    .two-col { gap: 32px; }
    .side-photo { height: 280px; }
  }
</style>
