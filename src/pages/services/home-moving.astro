---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CTABanner from '../../components/CTABanner.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
---
<!-- KW research: Primary = home movers kampala
     Secondary: house movers kampala, residential movers uganda, house shifting services kampala, affordable movers kampala
     Title (exact): Home Movers in Kampala | Trusted House Shifting Services
     Meta (exact, 155 chars): Reliable home movers in Kampala. Safe packing, transport & setup for your household. Affordable, professional & fully insured. Get your free moving quote today.
     H1 (exact): Home Movers & House Shifting Services in Kampala -->
<BaseLayout
  title="Home Movers in Kampala | Trusted House Shifting Services"
  description="Reliable home movers in Kampala. Safe packing, transport & setup for your household. Affordable, professional & fully insured. Get your free moving quote today."
>
  <PageHero eyebrow="Home Moving" title="Home Movers &amp; House Shifting Services in Kampala" subtitle="Reliable, affordable home movers in Kampala - safe packing, careful transport and full setup. The same professional standard we apply to corporate clients, for your household." image="https://images.unsplash.com/photo-1600585154526-990dced4db0d?w=1600&q=80&auto=format&fit=crop" imageAlt="Professional home movers carefully packing household furniture in Kampala Uganda" crumbs={[{label:'Home',href:'/'},{label:'Services',href:'/services'},{label:'Home Moving'}]} cta={{label:'Get a home moving quote',href:'/get-a-quote'}} />
  <div class="w page-body">
    <div class="two-col">
      <div>
        <span class="eyebrow">House shifting in Kampala</span>
        <h2 class="h2">Your home, moved with care.</h2>
        <div class="prose">
          <p>Most home moves in Kampala are done with hired pickups and untrained labour - furniture scratched, items lost, fragile things broken. Quick Shift brings corporate-grade professionalism to residential moves.</p>
          <p>We pack everything properly, wrap fragile items, disassemble beds and wardrobes and reassemble everything at the new address. You walk into a properly set-up home.</p>
          <p>We serve all Kampala districts for home moves - Ntinda, Kololo, Bugolobi, Naguru, Muyenga, Bukoto, Nalya, Kyambogo and more.</p>
        </div>
        <a href="/get-a-quote" class="btn btn--primary btn--lg" style="margin-top:28px">Get a home moving quote</a>
      </div>
      <div class="side-photo"><img src="https://images.unsplash.com/photo-1558618047-f5e2e69d5ec3?w=800&q=80&auto=format&fit=crop" alt="Home movers carefully packing household items in Kampala" class="img-cover" loading="lazy" width="800" height="600" /></div>
    </div>
    <section style="margin-top:72px">
      <span class="eyebrow">What's included</span>
      <h2 class="h2">Everything in one price.</h2>
      <div class="inc-grid">
        {['Free on-site survey','Professional packing & all materials','Furniture disassembly & reassembly','Fragile item handling','Covered transport','Setup & placement at new address','Goods-in-transit insurance','Clean loading & unloading'].map(i => (
          <div class="inc-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#FF7A1A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
            <span>{i}</span>
          </div>
        ))}
      </div>
    </section>
    <section style="margin-top:72px;max-width:760px">
      <span class="eyebrow">FAQs</span>
      <h2 class="h2">Home moving questions</h2>
      {[
        {q:'How much does it cost to move a house in Kampala?',a:'A small apartment (1–2 bedrooms) starts from UGX 600,000. A medium house (3 bedrooms) from UGX 1,200,000. Large homes from UGX 2,000,000. All prices fixed after free survey.'},
        {q:'How far in advance should I book?',a:'Weekday moves: 1 week is usually enough. Weekend moves: 2–3 weeks ahead, especially at month-end when demand is highest.'},
        {q:'Do you serve areas outside Kampala?',a:'Yes. We move households to and from Entebbe, Jinja, Mukono, Wakiso and other nearby areas. Distance pricing applies - contact us for a quote.'},
      ].map(f => (<details class="faq-item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </section>
  </div>
  <CTABanner title="Ready to move home?" subtitle="Professional packing, careful transport and full setup - all in one fixed price." primaryLabel="Get a home moving quote" />
  <WhatsAppButton />
</BaseLayout>
<style>
  .page-body { padding-top: 64px; padding-bottom: 72px; }
  .two-col { display: grid; grid-template-columns: 1fr; gap: 48px; align-items: center; }
  @media (min-width: 900px) { .two-col { grid-template-columns: 1fr 420px; } }
  .side-photo { border-radius: 16px; overflow: hidden; height: 460px; border: 1px solid #2c4263; }
  .inc-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; margin-top: 24px; }
  .inc-item { display: flex; align-items: flex-start; gap: 10px; background: #111f35; border: 1px solid #2c4263; border-radius: 10px; padding: 12px 14px; font-size: 14px; font-weight: 500; color: #cdd8e8; line-height: 1.4; }

  /* ── Responsive ── */
  @media (max-width: 640px) {
    .page-body { padding-top: 40px; padding-bottom: 48px; }
    .two-col { gap: 32px; }
    .side-photo { height: 280px; }
  }
</style>
