---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CTABanner from '../components/CTABanner.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';

const categories = [
  { label:'Pricing', items:[
    {q:'How much do office movers charge in Kampala?',a:'Small offices (1–10 staff) start from UGX 1,500,000. Medium (11–50 staff) from UGX 4,500,000. Large offices are custom-priced. All quotes fixed after free on-site survey - no hourly rates.'},
    {q:'Do you charge more for after-hours or weekend moves?',a:'No. After-hours and weekend moves are priced the same. It\'s our standard mode of operation, not a premium service.'},
    {q:'Is the free survey really free - no obligation?',a:'Yes. Completely free, no obligation. We visit, measure and send you a written quote. You decide whether to proceed.'},
  ]},
  { label:'Booking & Timing', items:[
    {q:'How far in advance should I book?',a:'Small offices: 2 weeks. Medium (10–50 staff): 4 weeks. Large or complex: 6–8 weeks. Popular weekend dates fill up fast - book early.'},
    {q:'How long does an office relocation take?',a:'Small office: one overnight session (6–8 hours). Medium: one full weekend. Large multi-floor: 2–3 nights.'},
    {q:'What days do you operate?',a:'Survey and planning: Mon–Sat, 7am–6pm. Moving crews: 24 hours including nights and weekends.'},
  ]},
  { label:'The Move', items:[
    {q:'What should we do to prepare?',a:'Back up computers, clear personal items from desks, communicate the new address to clients and notify building management at both addresses. We provide a full pre-move checklist after the survey.'},
    {q:'Do you disassemble and reassemble furniture?',a:'Yes - disassembly and reassembly is included in our standard service. Desks, workstations, partitions, shelving and conference tables.'},
    {q:'Can you move floors within the same building?',a:'Yes. Intra-building moves are common. We coordinate freight lift access and loading bay booking, and move after business hours to avoid disrupting other tenants.'},
  ]},
  { label:'Insurance & Damage', items:[
    {q:'Are your movers licensed and insured?',a:'Yes. Quick Shift Kampala is fully licensed and carries comprehensive goods-in-transit insurance. All items covered from packing to final setup.'},
    {q:'What happens if something is damaged?',a:'Every item is documented before we touch it. If anything is damaged we handle the claim and arrange replacement or repair at no cost to you.'},
  ]},
  { label:'Service Areas', items:[
    {q:'Which areas in Kampala do you cover?',a:'Every district: Nakasero, Kololo, Ntinda, Bugolobi, Naguru, Muyenga, Bukoto, Industrial Area and more. We also serve Entebbe, Jinja, Mbarara and other Uganda cities.'},
    {q:'Can you move us to another city?',a:'Yes. We regularly handle moves to Entebbe, Jinja, Mbarara and Gulu. Long-distance moves use covered trucks. Contact us for an inter-city quote.'},
  ]},
];

const faqSchema = {
  "@context":"https://schema.org","@type":"FAQPage",
  "mainEntity": categories.flatMap(c => c.items.map(i => ({
    "@type":"Question","name":i.q,
    "acceptedAnswer":{"@type":"Answer","text":i.a}
  })))
};
---

<!-- KW research: Primary = office moving FAQ
     Secondary: moving company questions, how much do movers cost in kampala, office relocation questions
     Title (exact): FAQ | Office & Home Moving Questions Answered
     Meta (exact, 153 chars): Got questions about moving your office or home in Kampala? Find answers about pricing, timelines, insurance, and what to expect on moving day.
     H1: Your moving questions, answered. -->
<BaseLayout
  title="FAQ | Office & Home Moving Questions Answered"
  description="Got questions about moving your office or home in Kampala? Find answers about pricing, timelines, insurance, and what to expect on moving day."
  schema={faqSchema}
>
  <PageHero eyebrow="FAQ" title="Your moving questions, answered." subtitle="How much do movers cost in Kampala? Are your items insured? Everything you need to know about office and home relocation in Kampala - answered." crumbs={[{label:'Home',href:'/'},{label:'FAQ'}]} />
  <div class="w page-body">
    <div class="faq-layout">
      <!-- Sidebar -->
      <nav class="faq-nav" aria-label="FAQ categories">
        <p class="faq-nav__label">Categories</p>
        {categories.map(c => (
          <a href={`#${c.label.toLowerCase().replace(/\s+/g,'-')}`} class="faq-nav__link">{c.label}</a>
        ))}
        <div class="faq-nav__cta">
          <p>Still have a question?</p>
          <a href="/contact" class="btn btn--outline btn--sm" style="width:100%;justify-content:center;margin-top:10px">Ask us</a>
        </div>
      </nav>

      <!-- Content -->
      <div>
        {categories.map(cat => (
          <section id={cat.label.toLowerCase().replace(/\s+/g,'-')} class="faq-cat" aria-labelledby={`cat-${cat.label}`}>
            <h2 id={`cat-${cat.label}`} class="faq-cat__title">{cat.label}</h2>
            {cat.items.map(f => (
              <details class="faq-item">
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </section>
        ))}
      </div>
    </div>
  </div>
  <CTABanner title="Still have a question?" subtitle="Call, WhatsApp or fill in the contact form - we respond within one hour during business hours." primaryLabel="Contact us" primaryHref="/contact" whatsappLabel="WhatsApp now" />
  <WhatsAppButton />
</BaseLayout>

<style>
  .page-body { padding-top: 64px; padding-bottom: 72px; }
  .faq-layout { display: grid; grid-template-columns: 1fr; gap: 48px; align-items: start; }
  @media (min-width: 960px) { .faq-layout { grid-template-columns: 200px 1fr; } }
  .faq-nav { position: sticky; top: 80px; background: #111f35; border: 1px solid #2c4263; border-radius: 14px; padding: 20px; }
  @media (max-width: 959px) { .faq-nav { display: none; } }
  .faq-nav__label { font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em; color: #9fb0c8; margin-bottom: 12px; }
  .faq-nav__link { display: block; padding: 7px 10px; font-size: 14px; font-weight: 600; color: #9fb0c8; border-radius: 8px; text-decoration: none; transition: background 0.15s, color 0.15s; }
  .faq-nav__link:hover { background: rgba(255,122,26,0.1); color: #FF7A1A; }
  .faq-nav__cta { margin-top: 20px; padding-top: 16px; border-top: 1px solid #2c4263; }
  .faq-nav__cta p { font-size: 13px; color: #9fb0c8; margin-bottom: 0; }
  .faq-cat { margin-bottom: 56px; scroll-margin-top: 100px; }
  .faq-cat__title { font-size: 22px; font-weight: 800; color: #fff; margin-bottom: 20px; padding-bottom: 14px; border-bottom: 1px solid #2c4263; }

  /* ── Responsive ── */
  @media (max-width: 640px) {
    .page-body { padding-top: 40px; padding-bottom: 48px; }
    .faq-cat { margin-bottom: 40px; }
  }
</style>
