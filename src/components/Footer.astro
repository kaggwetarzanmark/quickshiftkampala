<style>
  .site-footer {
    background: #060e1a;
    color: #9fb0c8;
    font-family: 'Sora', sans-serif;
    font-size: 14px;
    border-top: 1px solid #2c4263;
    margin-top: clamp(48px, 7vw, 72px);
  }

  /* Top grid */
  .footer-top {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 40px;
    padding-top: 56px;
    padding-bottom: 48px;
  }

  /* Brand */
  .footer-logo {
    font-size: 20px;
    font-weight: 800;
    color: #fff;
    text-decoration: none;
    display: block;
    margin-bottom: 10px;
    letter-spacing: -0.02em;
  }
  .footer-logo:hover { color: #fff; }
  .footer-dot { color: #FF7A1A; }
  .footer-brand p { font-size: 13px; line-height: 1.65; color: #9fb0c8; margin-bottom: 16px; }

  .footer-social { display: flex; gap: 10px; }
  .social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: rgba(255,255,255,0.06);
    border-radius: 8px;
    color: #9fb0c8;
    text-decoration: none;
    transition: background 0.15s, color 0.15s;
  }
  .social-icon:hover { background: rgba(255,122,26,0.15); color: #FF7A1A; }

  /* Columns */
  .footer-col { display: flex; flex-direction: column; gap: 10px; }
  .footer-col__heading {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.35);
    margin-bottom: 6px;
  }
  .footer-col a,
  .footer-col span {
    font-size: 14px;
    font-weight: 500;
    color: #9fb0c8;
    text-decoration: none;
    transition: color 0.15s;
    line-height: 1.5;
  }
  .footer-col a:hover { color: #FF7A1A; }
  .footer-cta { margin-top: 8px; align-self: flex-start; }

  /* Bottom bar - V2 exact flex justify-between */
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    padding: 20px 0;
    border-top: 1px solid #2c4263;
    font-size: 12px;
    color: rgba(159,176,200,0.6);
  }

  @media (max-width: 640px) {
    .footer-bottom { flex-direction: column; gap: 8px; text-align: center; align-items: center; }
    .footer-bottom span:nth-child(2) { display: none; }
    .footer-top { padding-top: 40px; padding-bottom: 32px; gap: 32px; }
  }
</style>
