---
interface Props {
  number: string;
  title: string;
  description: string;
  href: string;
  featured?: boolean;
}
const { number, title, description, href, featured = false } = Astro.props;
---

<a
  href={href}
  class={`svc-card ${featured ? 'svc-card--orange' : ''}`}
  aria-label={`${title} - learn more`}
>
  <div class="svc-card__num" aria-hidden="true">{number}</div>
  <h3 class="svc-card__title">{title}</h3>
  <p class="svc-card__desc">{description}</p>
  <span class="svc-card__arrow" aria-hidden="true">→</span>
</a>

<style>
  .svc-card {
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    padding: 24px;
    display: block;
    text-decoration: none;
    color: var(--text);
    background: var(--bg-card);
    transition: border-color .18s, background .18s;
  }

  .svc-card:hover {
    border-color: var(--accent);
    background: #132030;
    opacity: 1;
  }

  .svc-card--orange {
    background: linear-gradient(135deg, var(--accent) 0%, #e55a00 100%);
    border-color: transparent;
    color: #fff;
  }
  .svc-card--orange:hover { background: linear-gradient(135deg, #ff8c35 0%, #f06010 100%); }

  .svc-card__num {
    font-family: var(--font);
    font-weight: 800;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    line-height: 1;
  }
  .svc-card--orange .svc-card__num { color: rgba(255,255,255,0.7); }

  .svc-card__title {
    font-family: var(--font);
    font-weight: 800;
    font-size: 20px;
    letter-spacing: -.02em;
    margin: 10px 0 8px;
    color: var(--text);
    line-height: 1.1;
  }
  .svc-card--orange .svc-card__title { color: #fff; }

  .svc-card__desc {
    margin: 0 0 16px;
    line-height: 1.6;
    color: var(--muted);
    font-size: 14px;
  }
  .svc-card--orange .svc-card__desc { color: rgba(255,255,255,0.85); }

  .svc-card__arrow {
    font-size: 16px;
    font-weight: 700;
    color: var(--accent);
    transition: transform .15s;
    display: inline-block;
  }
  .svc-card--orange .svc-card__arrow { color: #fff; }
  .svc-card:hover .svc-card__arrow { transform: translateX(4px); }

  @media (max-width: 380px) {
    .svc-card { padding: 20px; }
  }
</style>
