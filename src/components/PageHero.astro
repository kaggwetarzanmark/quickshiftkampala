---
import Breadcrumbs from './Breadcrumbs.astro';

interface Crumb { label: string; href?: string; }
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  image?: string;
  imageAlt?: string;
  crumbs?: Crumb[];
  cta?: { label: string; href: string };
  ctaSecondary?: { label: string; href: string };
}
const { eyebrow, title, subtitle, image, imageAlt, crumbs, cta, ctaSecondary } = Astro.props;
---

<section class="page-hero">
  {image && (
    <div class="page-hero__img" aria-hidden="true">
      <img src={image} alt={imageAlt ?? title} class="img-cover" loading="eager" decoding="async" width="1440" height="420" />
      <div class="page-hero__img-overlay"></div>
    </div>
  )}

  <div class="page-hero__content w">
    {crumbs && (
      <nav class="page-hero__crumbs" aria-label="Breadcrumb">
        <ol class="breadcrumbs__list" role="list">
          {crumbs.map((c, i) => (
            <li class="breadcrumbs__item">
              {i < crumbs.length - 1
                ? <a href={c.href} class="breadcrumbs__link">{c.label}</a>
                : <span class="breadcrumbs__current" aria-current="page">{c.label}</span>
              }
              {i < crumbs.length - 1 && <span class="breadcrumbs__sep" aria-hidden="true">/</span>}
            </li>
          ))}
        </ol>
      </nav>
    )}

    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1 class="page-hero__title">{title}</h1>
    {subtitle && <p class="page-hero__sub">{subtitle}</p>}

    {(cta || ctaSecondary) && (
      <div class="page-hero__btns">
        {cta && <a href={cta.href} class="btn btn--primary btn--lg">{cta.label}</a>}
        {ctaSecondary && <a href={ctaSecondary.href} class="btn btn--outline btn--lg">{ctaSecondary.label}</a>}
      </div>
    )}
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    padding: 80px 0 72px;
    overflow: hidden;
  }

  /* If image is present, overlay on top of it */
  .page-hero__img {
    position: absolute;
    inset: 0;
  }
  .page-hero__img-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(11,22,38,0.72) 0%, rgba(11,22,38,0.88) 100%);
  }

  /* No image - subtle gradient from bg */
  .page-hero:not(:has(.page-hero__img)) {
    background: linear-gradient(135deg, #0f1d30 0%, #0B1626 100%);
    border-bottom: 1px solid #2c4263;
  }

  .page-hero__content {
    position: relative;
    z-index: 1;
    max-width: 760px;
  }

  .page-hero__crumbs {
    margin-bottom: 20px;
    opacity: 0.7;
  }

  .page-hero__title {
    font-size: clamp(32px, 5vw, 54px);
    line-height: 1.06;
    font-weight: 800;
    color: #fff;
    margin: 8px 0 18px;
  }

  .page-hero__sub {
    font-size: 18px;
    color: #9fb0c8;
    line-height: 1.65;
    max-width: 600px;
    margin-bottom: 32px;
  }

  .page-hero__btns {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
</style>
